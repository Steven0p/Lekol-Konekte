# Copier ce fichier vers .env et remplir les valeurs

# Serveur
PORT=4000
NODE_ENV=development
# Origine du frontend (pour CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lekol_konekte

# Session (cookie httpOnly) — mettre une longue chaine aleatoire
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Courriel (Nodemailer / SMTP) — les courriels partent reellement.
# Fournisseur retenu : Brevo (300 courriels/jour gratuits, pas de 2FA obligatoire).
#   https://app.brevo.com -> SMTP & API -> onglet SMTP
#   SMTP_USER = le « Login » affiche (du type 9a1b2c001@smtp-brevo.com)
#   SMTP_PASS = la « cle SMTP » generee dans ce meme ecran
#   MAIL_FROM = une adresse validee dans Brevo (Senders -> Add a sender)
# Gmail direct fonctionne aussi (smtp.gmail.com:587) mais exige la validation
# en 2 etapes + un mot de passe d'application.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lekol Konekte <votre.adresse.validee@exemple.com>"
OTP_EXPIRATION_MIN=10
