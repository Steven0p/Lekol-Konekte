# Copier ce fichier vers .env et remplir les valeurs

# Serveur
PORT=4000
NODE_ENV=development
# Origine du frontend (pour CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lekol_konekte

# Session (cookie httpOnly) — mettre une longue chaine aleatoire
SESSION_SECRET=change-moi-en-une-longue-chaine-aleatoire

# Courriel (Nodemailer / SMTP)
# En dev, laisser SMTP_HOST vide : un compte de test Ethereal est cree automatiquement
# et l'URL d'apercu du courriel s'affiche dans les logs du serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lekol Konekte <no-reply@lekolkonekte.ht>"
OTP_EXPIRATION_MIN=10
