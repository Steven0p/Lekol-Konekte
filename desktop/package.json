{
  "name": "lekol-konekte-poste",
  "version": "1.0.0",
  "description": "Lekòl Konekte — application de bureau (hors ligne, synchronisée)",
  "homepage": "https://lekolkonekte.online",
  "author": "Plaisival Steven",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "stack:test": "node electron/_test-stack.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "mysql2": "3.24.4"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.1",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "online.lekolkonekte.poste",
    "productName": "Lekol Konekte",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "!electron/_test-stack.mjs"
    ],
    "extraResources": [
      { "from": "../backend", "to": "backend",
        "filter": ["**/*", "!.env", "!uploads/**", "!node_modules/.cache/**"] },
      { "from": "../frontend/dist", "to": "frontend/dist" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "extraResources": [
        { "from": "vendor/mariadb/win", "to": "mariadb" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Lekol Konekte"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education",
      "maintainer": "Plaisival Steven <plaisivalsteven8@gmail.com>",
      "synopsis": "Plateforme de gestion scolaire (poste hors ligne)",
      "description": "Lekòl Konekte — application de bureau : fonctionne hors ligne sur une base MariaDB locale et se synchronise avec le nuage."
    },
    "deb": {
      "depends": ["mariadb-server"]
    }
  }
}
